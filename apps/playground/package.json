{
  "name": "@framework/playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm --filter @framework/server build && pnpm --filter @framework/client build && node --import tsx --test ./test"
  },
  "dependencies": {
    "@framework/client": "workspace:*",
    "@framework/core": "workspace:*",
    "@framework/server": "workspace:*",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  }
}
