{
  "name": "@restfx/core",
  "version": "0.1.0",
  "description": "Browser-safe shared models, validation, field types, and typed configuration for RestFX.",
  "license": "Apache-2.0",
  "keywords": [
    "restfx",
    "typescript",
    "validation",
    "models"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "pnpm build",
    "typecheck": "tsc -b --pretty false",
    "test": "node --import tsx --test ./test"
  }
}
