{
  "name": "@restfx/core",
  "version": "0.2.0",
  "description": "Browser-safe shared models, validation, field types, and typed configuration for RestFX.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkcraft/restfx.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/thinkcraft/restfx/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/thinkcraft/restfx/issues"
  },
  "keywords": [
    "restfx",
    "typescript",
    "validation",
    "models"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "pnpm build",
    "typecheck": "tsc -b --pretty false",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  }
}
