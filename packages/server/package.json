{
  "name": "@restfx/server",
  "version": "0.1.0",
  "description": "Node.js HTTP server with decorated resources, routing, middleware, and OpenAPI for RestFX.",
  "license": "Apache-2.0",
  "keywords": [
    "restfx",
    "http",
    "server",
    "typescript",
    "openapi"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "pnpm build",
    "test": "node --import tsx --test ./test",
    "typecheck": "tsc -b --pretty false",
    "bench:routing": "node --import tsx ./bench/routing.bench.ts",
    "bench:http": "node --import tsx ./bench/http.bench.ts",
    "bench:http:express": "node --import tsx ./bench/http.bench.ts --server express",
    "loadtest:http": "node --import tsx ./bench/http.load.ts",
    "profile:http": "node --import tsx ./bench/http.profile.ts"
  },
  "dependencies": {
    "@restfx/core": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  }
}
