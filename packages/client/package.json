{
  "name": "@restfx/client",
  "version": "0.1.1",
  "description": "Browser fetch client and OpenAPI client generator for RestFX.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkcraft/restfx.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/thinkcraft/restfx/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/thinkcraft/restfx/issues"
  },
  "keywords": [
    "restfx",
    "fetch",
    "openapi",
    "typescript",
    "client"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "restfx-client": "./cli/generate.mjs"
  },
  "files": [
    "dist",
    "cli/generate.mjs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "pnpm build",
    "generate": "node ./cli/generate.mjs",
    "test": "pnpm build && node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@restfx/core": "workspace:*"
  }
}
