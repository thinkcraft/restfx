{
  "name": "@restfx/client",
  "version": "0.1.0",
  "description": "Browser fetch client and OpenAPI client generator for RestFX.",
  "license": "Apache-2.0",
  "keywords": [
    "restfx",
    "fetch",
    "openapi",
    "typescript",
    "client"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "restfx-client": "./cli/generate.mjs"
  },
  "files": [
    "dist",
    "cli/generate.mjs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "pnpm build",
    "generate": "node ./cli/generate.mjs",
    "test": "pnpm build && node --import tsx --test ./test",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@restfx/core": "workspace:*"
  }
}
