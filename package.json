{
  "name": "restfx",
  "version": "0.1.0",
  "private": true,
  "description": "RestFX, a full-stack TypeScript framework",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkcraft/restfx.git"
  },
  "homepage": "https://github.com/thinkcraft/restfx#readme",
  "bugs": {
    "url": "https://github.com/thinkcraft/restfx/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "pnpm --filter @restfx/playground dev",
    "docs:dev": "pnpm --filter @restfx/docs dev",
    "docs:build": "pnpm --filter @restfx/docs build",
    "docs:publish": "gh workflow run deploy-docs.yml --ref main",
    "docs:preview": "pnpm --filter @restfx/docs preview",
    "lint": "eslint packages apps",
    "typecheck": "tsc -b --pretty false",
    "start": "tsx packages/server/src",
    "test": "pnpm --filter @restfx/* test"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.1.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
