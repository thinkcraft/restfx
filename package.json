{
  "name": "restfx",
  "version": "0.1.0",
  "private": true,
  "description": "RestFX, a full-stack TypeScript framework",
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "pnpm --filter @restfx/playground dev",
    "typecheck": "tsc -b --pretty false",
    "start": "tsx packages/server/src",
    "test": "pnpm --filter @restfx/* test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
